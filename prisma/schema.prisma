generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ShiftStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  ON_LEAVE
}

enum AttendanceApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkLocationType {
  OFFICE
  REMOTE
  MEETING
  FIELD
}

enum NotificationType {
  ATTENDANCE_APPROVAL
  ATTENDANCE_CORRECTION
  SYSTEM
}

enum WorkLocationStatus {
  ACTIVE
  INACTIVE
}

model User {
  id               String     @id @default(uuid()) @map("userId") @db.Uuid
  email            String     @unique @db.VarChar(255)
  passwordHash     String     @db.VarChar(255)
  role             UserRole   @default(EMPLOYEE)
  status           UserStatus @default(ACTIVE)
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  refreshTokenHash String?

  employeeProfile EmployeeProfile?
  registeredDevices EmployeeDevice[] @relation("EmployeeDeviceOwner")
  approvedDevices EmployeeDevice[] @relation("EmployeeDeviceApprover")
  deviceChallenges EmployeeDeviceChallenge[]
  updatedDayOverrides EmployeeDayOverride[] @relation("DayOverrideEditor")
  adminProfile    AdminProfile?

  notifications Notification[]
  auditLogs     AuditLog[]     @relation("AuditLogActor")

  createdLocationAssignments LocationAssignment[] @relation("LocationAssignmentCreator")
  reviewedAttendanceSessions AttendanceSession[]  @relation("AttendanceSessionReviewer")

  requestedAttendanceCorrections AttendanceCorrectionRequest[] @relation("CorrectionRequester")
  reviewedAttendanceCorrections  AttendanceCorrectionRequest[] @relation("CorrectionReviewer")

  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model EmployeeProfile {
  id           String    @id @default(uuid()) @map("employeeProfileId") @db.Uuid
  userId       String    @unique @db.Uuid
  employeeCode String    @unique @db.VarChar(50)
  firstName    String    @db.VarChar(100)
  lastName     String    @db.VarChar(100)
  phone        String?   @unique @db.VarChar(20)
  designation  String?   @db.VarChar(100)
  joiningDate  DateTime?
  avatarUrl    String?

  departmentId   String? @db.Uuid
  shiftId        String? @db.Uuid
  workLocationId String? @db.Uuid

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  shift      Shift?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  workLocation WorkLocation? @relation("PermanentEmployeeLocation", fields: [workLocationId], references: [id], onDelete: SetNull)

  attendanceRecords            AttendanceRecord[]
  temporaryLocationAssignments LocationAssignment[]

  attendanceCorrectionRequests AttendanceCorrectionRequest[]
  dayOverrides EmployeeDayOverride[]
  shiftAssignments EmployeeShiftAssignment[]
  avatar EmployeeAvatar?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([shiftId])
  @@index([workLocationId])
  @@map("employee_profiles")
}

model AdminProfile {
  id          String  @id @default(uuid()) @map("adminProfileId") @db.Uuid
  userId      String  @unique @db.Uuid
  firstName   String  @db.VarChar(100)
  lastName    String  @db.VarChar(100)
  phone       String? @unique @db.VarChar(20)
  designation String? @db.VarChar(100)
  avatarUrl   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_profiles")
}

model Department {
  id          String  @id @default(uuid()) @map("departmentId") @db.Uuid
  name           String  @db.VarChar(100)
  description    String?
  organizationId String? @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  employees EmployeeProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

model Shift {
  id             String @id @default(uuid()) @map("shiftId") @db.Uuid
  name           String @db.VarChar(100)
  organizationId String? @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  startTime      String @db.VarChar(5)
  endTime   String @db.VarChar(5)

  gracePeriodMinutes           Int  @default(10)
  lateReasonAfterMinutes       Int?
  approvalRequiredAfterMinutes Int?

  status ShiftStatus @default(ACTIVE)

  employees EmployeeProfile[]
  employeeShiftAssignments EmployeeShiftAssignment[]
  attendanceSessions AttendanceSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("shifts")
}

model AttendanceRecord {
  id                String           @id @default(uuid()) @map("attendanceRecordId") @db.Uuid
  employeeProfileId String           @db.Uuid
  workDate          DateTime         @db.Date
  status            AttendanceStatus @default(PRESENT)
  totalWorkMinutes  Int              @default(0)
  assignedShiftCount Int             @default(1)
  notes             String?

  employeeProfile EmployeeProfile     @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  sessions        AttendanceSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeProfileId, workDate])
  @@index([workDate])
  @@index([status])
  @@map("attendance_records")
}

model AttendanceSession {
  id                 String @id @default(uuid()) @map("attendanceSessionId") @db.Uuid
  attendanceRecordId String @db.Uuid

  punchInAt  DateTime  @default(now())
  punchOutAt DateTime?

  punchInLatitude  Float?
  punchInLongitude Float?
  punchInAccuracy  Float?

  punchOutLatitude  Float?
  punchOutLongitude Float?
  punchOutAccuracy  Float?

  // Stored on the session so historical exports survive future assignment edits.
  shiftOrder Int?
  shiftId String? @db.Uuid
  shiftName String? @db.VarChar(100)
  shiftStartTime String? @db.VarChar(5)
  shiftEndTime String? @db.VarChar(5)

  approvalStatus AttendanceApprovalStatus @default(NOT_REQUIRED)

  correctionRequests AttendanceCorrectionRequest[]
  locationAlerts AttendanceLocationAlert[]
  punchInDeviceId String? @db.Uuid
  punchOutDeviceId String? @db.Uuid
  punchInDevice EmployeeDevice? @relation("PunchInDevice", fields: [punchInDeviceId], references: [id], onDelete: SetNull)
  punchOutDevice EmployeeDevice? @relation("PunchOutDevice", fields: [punchOutDeviceId], references: [id], onDelete: SetNull)

  lateMinutes Int     @default(0)
  lateReason  String?

  reviewedByUserId String?   @db.Uuid
  reviewedAt       DateTime?
  rejectionReason  String?

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  shift Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  reviewedBy       User?            @relation("AttendanceSessionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attendanceRecordId])
  @@unique([attendanceRecordId, shiftOrder])
  @@index([shiftId])
  @@index([approvalStatus])
  @@index([reviewedByUserId])
  @@index([punchInDeviceId])
  @@index([punchOutDeviceId])
  @@map("attendance_sessions")
}

model WorkLocation {
  id           String             @id @default(uuid()) @map("workLocationId") @db.Uuid
  name         String             @db.VarChar(150)
  type         WorkLocationType
  address      String?
  latitude     Float
  longitude    Float
  radiusMeters Int                @default(100)
  allowedPublicIps String[] @default([])
  status       WorkLocationStatus @default(ACTIVE)
  organizationId String? @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  permanentEmployees   EmployeeProfile[]    @relation("PermanentEmployeeLocation")
  temporaryAssignments LocationAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([organizationId])
  @@map("work_locations")
}

model LocationAssignment {
  id                String @id @default(uuid()) @map("locationAssignmentId") @db.Uuid
  employeeProfileId String @db.Uuid
  workLocationId    String @db.Uuid
  createdByUserId   String @db.Uuid

  startAt DateTime
  endAt   DateTime
  reason  String?

  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  workLocation    WorkLocation    @relation(fields: [workLocationId], references: [id], onDelete: Restrict)
  createdBy       User            @relation("LocationAssignmentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([employeeProfileId, startAt, endAt])
  @@index([workLocationId])
  @@map("location_assignments")
}

model AttendanceCorrectionRequest {
  id                  String  @id @default(uuid()) @map("attendanceCorrectionRequestId") @db.Uuid
  employeeProfileId   String  @db.Uuid
  attendanceSessionId String  @db.Uuid
  requestedByUserId   String  @db.Uuid
  reviewedByUserId    String? @db.Uuid

  // Original attendance times
  originalPunchInAt  DateTime
  originalPunchOutAt DateTime?

  // Requested corrected times
  requestedPunchInAt  DateTime
  requestedPunchOutAt DateTime?

  reason String @db.VarChar(500)

  status AttendanceCorrectionStatus @default(PENDING)

  reviewedAt      DateTime?
  rejectionReason String?

  employeeProfile   EmployeeProfile   @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)

  requestedBy User  @relation("CorrectionRequester", fields: [requestedByUserId], references: [id])
  reviewedBy  User? @relation("CorrectionReviewer", fields: [reviewedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeProfileId])
  @@index([attendanceSessionId])
  @@index([status])
  @@map("attendance_correction_requests")
}

model Notification {
  id      String           @id @default(uuid()) @map("notificationId") @db.Uuid
  userId  String           @db.Uuid
  title   String           @db.VarChar(150)
  message String           @db.VarChar(500)
  type    NotificationType @default(SYSTEM)
  isRead  Boolean          @default(false)
  readAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model AuditLog {
  id          String  @id @default(uuid()) @map("auditLogId") @db.Uuid
  actorUserId String? @db.Uuid

  action      String  @db.VarChar(100)
  entityType  String  @db.VarChar(100)
  entityId    String? @db.VarChar(100)
  description String  @db.VarChar(500)

  metadata  Json?
  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(500)

  actor     User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

model Organization {
  id     String             @id @default(uuid()) @map("organizationId") @db.Uuid
  name   String             @unique @db.VarChar(150)
  status OrganizationStatus @default(ACTIVE)

  users User[]
  departments Department[]
  shifts Shift[]
  workLocations WorkLocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("organizations")
}


// Ordered assignments make any practical number of daily shifts possible.
// EmployeeProfile.shiftId stays as a compatibility reference to Shift 1.
model EmployeeShiftAssignment {
  id                String @id @default(uuid()) @db.Uuid
  employeeProfileId String @db.Uuid
  shiftId           String @db.Uuid
  sequence          Int

  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeProfileId, sequence])
  @@unique([employeeProfileId, shiftId])
  @@index([shiftId])
  @@map("employee_shift_assignments")
}

// Avatar contents are kept apart from employee profile/list queries.
// A dedicated authorized endpoint reads the file; never return bytes in JSON.
model EmployeeAvatar {
  employeeProfileId String @id @db.Uuid
  content Bytes @db.ByteA
  mimeType String @db.VarChar(30)
  updatedAt DateTime @updatedAt
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@map("employee_avatars")
}

// Employee-specific approved day classification. No default weekends are inferred:
// Admin explicitly marks days so different organizations can use different calendars.
enum EmployeeDayType {
  WEEKEND
  HOLIDAY
}

model EmployeeDayOverride {
  id                String @id @default(uuid()) @map("employeeDayOverrideId") @db.Uuid
  employeeProfileId String @db.Uuid
  workDate          DateTime @db.Date
  dayType           EmployeeDayType
  note              String? @db.VarChar(500)
  updatedByUserId   String @db.Uuid
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  updatedBy         User @relation("DayOverrideEditor", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([employeeProfileId, workDate])
  @@index([workDate])
  @@map("employee_day_overrides")
}

// Browser-held, non-exportable signing key. This is a browser-profile credential, not a hardware ID.
enum EmployeeDeviceStatus {
  PENDING
  APPROVED
  REVOKED
}

model EmployeeDevice {
  id String @id @default(uuid()) @map("employeeDeviceId") @db.Uuid
  userId String @db.Uuid
  keyFingerprint String @unique @db.VarChar(64)
  publicKeySpki String @db.Text
  label String @db.VarChar(120)
  deviceType String? @db.VarChar(32)
  operatingSystem String? @db.VarChar(100)
  browser String? @db.VarChar(100)
  userAgent String? @db.VarChar(500)
  status EmployeeDeviceStatus @default(PENDING)
  approvedByUserId String? @db.Uuid
  approvedAt DateTime?
  revokedAt DateTime?
  lastSeenAt DateTime?
  lastIp String? @db.VarChar(45)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("EmployeeDeviceOwner", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("EmployeeDeviceApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  challenges EmployeeDeviceChallenge[]
  punchInSessions AttendanceSession[] @relation("PunchInDevice")
  punchOutSessions AttendanceSession[] @relation("PunchOutDevice")

  @@index([userId, status])
  @@map("employee_devices")
}

model EmployeeDeviceChallenge {
  id String @id @default(uuid()) @map("employeeDeviceChallengeId") @db.Uuid
  userId String @db.Uuid
  deviceId String? @db.Uuid
  purpose String @db.VarChar(20)
  challenge String @db.VarChar(128)
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  device EmployeeDevice? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("employee_device_challenges")
}

// One record per confirmed exit / re-entry episode during an approved punch-in.
// Coordinates are employee-browser reported, NOT tamper-proof physical evidence.
model AttendanceLocationAlert {
  id String @id @default(uuid()) @map("attendanceLocationAlertId") @db.Uuid
  attendanceSessionId String @db.Uuid
  organizationId String @db.Uuid
  workLocationId String @db.Uuid
  workLocationName String @db.VarChar(150)
  workLocationLatitude Float
  workLocationLongitude Float
  radiusMeters Int
  exitLatitude Float
  exitLongitude Float
  exitAccuracy Float
  exitLocationName String? @db.VarChar(300)
  leftAt DateTime @default(now())
  returnedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)

  @@index([attendanceSessionId, returnedAt])
  @@index([organizationId, leftAt])
  @@index([workLocationId, leftAt])
  @@map("attendance_location_alerts")
}
